# ========================================================
# OpenWrt & OpenClash 控制器环境变量预配置文件
# 所有敏感信息均在此配置，小白用户在网页端打开即用，无需额外设置
# ========================================================

# 本服务对外运行端口
PORT=8080

# --------------------------------------------------------
# 1. OpenWrt 路由器连接配置
# --------------------------------------------------------
# OpenWrt 主路由局域网 IP
OPENWRT_HOST=192.168.1.1

# --------------------------------------------------------
# 2. OpenClash 外部控制 (RESTful API) 配置
# 在 OpenWrt 的 OpenClash 设置 -> 外部控制 中查看
# --------------------------------------------------------
# 外部控制端口（默认 9090）
OPENCLASH_API_PORT=9090

# 外部控制密钥 (Secret，若未设置可留空)
OPENCLASH_API_SECRET=

# --------------------------------------------------------
# 3. OpenWrt 系统管理凭证 (用于控制服务彻底启停及切换机场配置文件)
# --------------------------------------------------------
# SSH 端口（默认 22）
OPENWRT_SSH_PORT=22

# SSH 登录用户名（默认 root）
OPENWRT_SSH_USER=root

# SSH 登录密码（留空则不启用 SSH 级服务操作，降级为核心代理模式直连切换）
OPENWRT_SSH_PASS=

# SSH 私钥路径（可选，若使用密钥认证可挂载到容器中，如 /app/keys/id_rsa）
OPENWRT_SSH_KEY=

# --------------------------------------------------------
# 4. 开关控制策略与测速配置
# --------------------------------------------------------
# 开关策略：
# - smart: 优先通过 OpenWrt 系统服务启停；若未配置 SSH 则自动通过模式切换(Direct/Rule)秒级生效
# - service: 仅使用 OpenWrt init.d 服务完全启停 (/etc/init.d/openclash)
# - mode: 仅使用 Clash 运行模式切换 (Direct 直连 = 关闭, Rule 规则 = 开启)
POWER_TOGGLE_MODE=smart

# 节点测速网址
TEST_URL=http://www.gstatic.com/generate_204

# 节点测速超时时间（毫秒）
TEST_TIMEOUT=3000

# 网页在前台激活时的自动刷新间隔（秒，后台休眠时自动挂起为 0 开销）
POLL_INTERVAL=5

# 本地连接日志保留天数（默认8天，超期自动轮转清理）
CONN_LOG_RETENTION_DAYS=8

# 订阅下载代理（可选。当本服务运行在外部机器上且直连机场域名被墙时，可配置如 http://192.168.1.1:7890）
SUBSCRIPTION_PROXY=

# 系统时区设置（默认与宿主机中国标准时间 Asia/Shanghai 一致）
TZ=Asia/Shanghai


